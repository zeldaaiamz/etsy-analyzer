# ===== 运行模式 =====
# mock=全部用内存队列+假数据（本地自测）；real=连接 Supabase 与真实 provider
WORKER_MODE=mock
WORKER_ID=box-worker-1
POLL_INTERVAL_SECONDS=5
MAX_AMAZON_RESULTS=10

# ===== Supabase（real 模式必填；service_role key 只放在本机，绝不进前端/仓库）=====
SUPABASE_URL=https://oiymgpargbesvcfxyksj.supabase.co
# anon key（前端用，worker 不用；仅供参考）
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9peW1ncGFyZ2Jlc3ZjZnh5a3NqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE5NTMxMTAsImV4cCI6MjEwNzUyOTExMH0.Pc-aNYcsvQBC_-Lq8y9kVth2deY4uTckyAkrp45e5Z0
# service_role key 无法通过 MCP 获取：需在 Supabase Dashboard → Project Settings → API Keys 手动复制（仅写入本机 .env）
SUPABASE_SERVICE_ROLE_KEY=

# ===== Etsy Open API v3 =====
# mock | etsy_api
ETSY_PROVIDER=mock
# keystring（x-api-key）
ETSY_API_KEY=

# ===== Amazon 数据 =====
# mock | rainforest | keepa(待实现) | spapi(待实现)
AMAZON_PROVIDER=mock
RAINFOREST_API_KEY=
KEEPA_API_KEY=

# ===== LLM（OpenAI 兼容接口：OpenAI / DeepSeek / 通义 / xAI 等）=====
# mock | openai_compat
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 证据快照图片 =====
# mock | product_image（下载商品主图 + 搜索页数据摘要卡） | screenshot_api（第三方截图 API，失败回退主图）
SCREENSHOT_PROVIDER=mock
# 例: https://api.screenshotone.com/take?access_key={key}&url={url}&format=png&viewport_width=1280
SCREENSHOT_API_URL_TEMPLATE=
SCREENSHOT_API_KEY=
STORAGE_BUCKET=snapshots
# 每种类型最多保存几张快照，0 = 不限
MAX_SNAPSHOTS_PER_KIND=0

# ===== 评论分析规则 =====
# 每个商品至少分析多少条评论；不足则全部使用
MIN_REVIEWS=50
# 本商品评论不足时，是否用同店其它商品评论补足（会单独标注来源）
SUPPLEMENT_SHOP_REVIEWS=false

# ===== Keepa =====
# 每个关键词最多取多少个 ASIN 详情（每个约 1 token；搜索本身另计）
KEEPA_RESULTS_PER_KEYWORD=10

# ===== Keepamore（AMAZON_PROVIDER=keepamore；key 以 km_ 开头）=====
KEEPAMORE_API_KEY=
# 每个关键词取前 N 个 ASIN 查详情（1 unit/ASIN）；搜索 5 units/次
KEEPAMORE_RESULTS_PER_KEYWORD=10
