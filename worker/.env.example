# ===== 运行模式 =====
# mock=全部用内存队列+假数据（本地自测）；real=连接 Supabase 与真实 provider
WORKER_MODE=mock
WORKER_ID=box-worker-1
POLL_INTERVAL_SECONDS=5
MAX_AMAZON_RESULTS=10

# ===== Supabase（real 模式必填；service_role key 只放在本机，绝不进前端/仓库）=====
SUPABASE_URL=https://oiymgpargbesvcfxyksj.supabase.co
# anon key（前端用，worker 不用；仅供参考）
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9peW1ncGFyZ2Jlc3ZjZnh5a3NqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE5NTMxMTAsImV4cCI6MjEwNzUyOTExMH0.Pc-aNYcsvQBC_-Lq8y9kVth2deY4uTckyAkrp45e5Z0
# service_role key 无法通过 MCP 获取：需在 Supabase Dashboard → Project Settings → API Keys 手动复制（仅写入本机 .env）
SUPABASE_SERVICE_ROLE_KEY=

# ===== Etsy Open API v3 =====
# mock | etsy_api
ETSY_PROVIDER=mock
# keystring（x-api-key）
ETSY_API_KEY=

# ===== Amazon 数据 =====
# mock | rainforest | keepa(待实现) | spapi(待实现)
AMAZON_PROVIDER=mock
RAINFOREST_API_KEY=
KEEPA_API_KEY=

# ===== LLM（OpenAI 兼容接口：OpenAI / DeepSeek / 通义 / xAI 等）=====
# mock | openai_compat
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
