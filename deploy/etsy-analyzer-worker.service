# 生产：阿里云 ECS /etc/systemd/system/etsy-analyzer-worker.service（代码在 /opt/etsy-analyzer，见 ARCHITECTURE.md §15）
# 安装：cp 到 /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now etsy-analyzer-worker
[Unit]
Description=Etsy->Amazon analyzer worker (polls Supabase job queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/etsy-analyzer/worker
EnvironmentFile=/opt/etsy-analyzer/worker/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/etsy-analyzer/.venv/bin/python -m analyzer.main
Restart=always
RestartSec=10
TimeoutStopSec=300
MemoryHigh=350M
MemoryMax=500M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/etsy-analyzer/logs /opt/etsy-analyzer/worker
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=etsy-analyzer-worker

[Install]
WantedBy=multi-user.target
